FROM fedora:40

ARG SANITIZER=""
ENV SANITIZER="${SANITIZER}"

WORKDIR /usr/src/pecl-eio
COPY . .

RUN dnf update -y \
    && dnf install -y gcc-14'*' php-cli php-devel php-pear make \
    && dnf clean all

RUN ./ci/build.sh
# `docker-php-ext-enable --ini-name z-eio.ini eio` is not available on this image
RUN echo 'extension=eio.so' > /etc/php.d/z-eio.ini

ENV NO_INTERACTION=1
CMD ["./ci/test.sh"]

